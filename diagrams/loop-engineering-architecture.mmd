flowchart LR
    CHECK["1. CHECK DECK"]
    MAKE["2. MAKE CARD"]
    TEST["3. TEST CARD"]
    REVIEW["4. REVIEW CARD"]
    LEARN["5. SAVE + LEARN"]

    CHECK -- "empty: create from brief/spec; big: split; reorder + pick" --> MAKE
    MAKE --> TEST
    TEST -- "FAIL" --> MAKE
    TEST -- "PASS" --> REVIEW
    REVIEW -- "REJECT" --> MAKE
    REVIEW -- "PASS" --> LEARN
    LEARN -- "NEXT CARD" --> CHECK
