;; Maker sandbox (macOS sandbox-exec). OS-enforced boundary for a FULL-terminal maker:
;; READ anywhere (sibling repos like a sibling repo, the whole codebase, system libs),
;; WRITE only inside the worktree + hermes's own runtime/cache dirs, NO external network
;; (localhost allowed so the maker's hermes can reach ollama). This makes freedom real:
;; the maker can run any command yet cannot escape the folder, corrupt the main checkout,
;; or phone home, regardless of shims. Params: WT = worktree root, HH = hermes home.
(version 1)
(deny default)
(allow process-fork)
(allow process-exec)
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup)
;; reads: everywhere (context gathering is unfenced)
(allow file-read*)
;; writes: worktree + temp + hermes runtime + caches only
(allow file-write*
  (subpath (param "WT"))
  (subpath (param "HH"))
  (subpath "/private/tmp")
  (subpath "/private/var/folders")
  (subpath (param "CACHE"))
  (subpath (param "DOTCACHE")))
(allow file-write-data
  (literal "/dev/null") (literal "/dev/stdout") (literal "/dev/stderr") (literal "/dev/dtracehelper"))
;; network: deny external, allow localhost (ollama) + local unix sockets
(deny network*)
(allow network-outbound (remote ip "localhost:*"))
(allow network-outbound (remote unix-socket))
(allow network-bind (local ip "localhost:*"))
