#!/bin/sh
# Maker git policy: READ-ONLY allowed, harness-owned/destructive BLOCKED.
#
# Why read-only is allowed: the FREE local maker should gather its own context,
# reading history and sibling repos like a sibling repo with 'git -C <path> ...'.
# Making a paid model do that provisioning burns costly tokens against the whole
# free-local premise.
#
# Why the rest is blocked: the HARNESS owns commit + revert as the atomic gate unit.
# If the maker ran commit/reset/checkout/restore/clean/push, the gate's revert
# (git checkout -- . && git clean -fd) could no longer undo the session, so a failed
# card would leak broken code into the next one. That is destructive to the loop, so
# it stays blocked. This is not over-restriction; it protects the safety net.
export GIT_PAGER=cat PAGER=cat

# Find the subcommand, skipping safe leading globals. Refuse -c (config injection).
sub=""; skip=0
for a in "$@"; do
  [ "$skip" = 1 ] && { skip=0; continue; }
  case "$a" in
    -C|--git-dir|--work-tree) skip=1 ;;                 # -C <path>: read another repo
    -c) echo "BLOCKED: 'git -c' (config injection) is not allowed for the maker." >&2; exit 1 ;;
    --no-pager|-p|--paginate|--git-dir=*|--work-tree=*) : ;;
    -*) : ;;                                            # other leading global flags
    *) sub="$a"; break ;;
  esac
done

case "$sub" in
  log|show|diff|whatchanged|status|blame|annotate|ls-files|ls-tree|ls-remote|cat-file|\
  rev-parse|rev-list|show-ref|for-each-ref|merge-base|grep|describe|shortlog|count-objects|\
  fetch|clone|version|help|"")
    exec git "$@" ;;
  apply)
    # apply only writes WORKING-TREE files (same as the file tools), no git state. Allowed
    # so a retry can reapply its banked previous attempt (loop/state/wip-current.patch)
    # and fix the rejected lines instead of rebuilding from scratch. --index/--cached
    # variants would touch the index (harness-owned), so those stay blocked.
    for a in "$@"; do case "$a" in --index|--cached)
      echo "BLOCKED: 'git apply $a' touches the index (harness-owned). Use plain 'git apply <patch>'." >&2; exit 1 ;; esac; done
    exec git "$@" ;;
  *)
    echo "BLOCKED: 'git $sub' is owned by the harness. It commits and reverts each card" >&2
    echo "atomically, so commit/add/push/reset/checkout/restore/clean/rebase/merge/stash/" >&2
    echo "branch/tag would break that gate. Read-only git IS allowed: log, show, diff, grep," >&2
    echo "ls-files, ls-tree, rev-parse, clone, fetch, and 'git -C <path> ...' to read other" >&2
    echo "repos like a sibling repo. Write your source files; the harness handles git." >&2
    exit 1 ;;
esac
